{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "jco/global-content",
	"version": "0.1.0",
	"title": "JCORE Global Content",
	"category": "widgets",
	"icon": "text-page",
	"description": "Shows a global content item. Stores its slug, so a page moved to another site still finds it, and its id as a fallback.",
	"attributes": {
		"selectedPostId": {
			"type": "integer",
			"default": 0
		},
		"selectedSlug": {
			"type": "string",
			"default": ""
		}
	},
	"example": {},
	"supports": {
		"html": false
	},
	"textdomain": "jcore-maailma",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"render": "file:./render.php"
}
